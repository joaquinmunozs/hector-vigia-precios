# ATENCIÓN: este repositorio es PÚBLICO.
# Nada de lo que esté acá abajo debe subirse jamás.

# Credenciales. El token de Telegram vive en .env localmente y en los
# "Secrets" de GitHub Actions para la nube — NUNCA en el repo.
.env
.env.*
!.env.ejemplo
*.token
config.json
credenciales*.json

# Archivo puente para cargar secretos SIN pegarlos en un chat ni en un
# comando. Se escribe a mano, se usa una vez para llenar los secrets de
# GitHub y de Cloudflare, y se borra. Ver docs/PUESTA-EN-MARCHA.md.
secretos.local
secretos.local.*

# La base de precios. No va al repo a propósito: git no deduplica binarios
# que cambian en cada corrida, así que commitearla 6 veces al día haría
# crecer el historial sin freno. Persiste como "artifact" de GitHub Actions
# (ver .github/workflows/hector.yml), que en repos públicos es gratis e
# ilimitado.
*.db
*.db-wal
*.db-shm
*.db-journal

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Basura del sistema
.DS_Store
Thumbs.db

# Config local de Claude Code (permisos, preferencias de esta máquina).
.claude/settings.local.json

# Worker del proxy de tiendas (proxy-tiendas/): deps y estado local de Wrangler.
proxy-tiendas/node_modules/
proxy-tiendas/.wrangler/
proxy-tiendas/.dev.vars
