# Copiar a `.env` (que está en .gitignore) y completar.
# En la nube estos mismos valores van como Secrets del repo — ver
# .github/workflows/hector.yml. NUNCA con valores reales acá: el repo es
# público y el token de Telegram abre el grupo entero.

# El bot que manda los avisos (se saca de @BotFather).
TELEGRAM_BOT_TOKEN=

# El supergrupo donde escribe. Empieza con -100.
VIGIA_CHAT_ID=

# Los cuatro tópicos del grupo. Son IDs numéricos de "Temas" de Telegram;
# `configurar_telegram.py` los lista. Si faltan, esos avisos caen al hilo
# general y todo parece funcionar: no hay error, solo tópicos vacíos.
VIGIA_TOPICO_ERRORES=
VIGIA_TOPICO_OFERTAS=
VIGIA_TOPICO_ELECTRONICOS=
VIGIA_TOPICO_HOGAR=
